<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        T-070 — der Sockettransport öffnet TCP-Verbindungen. Ohne diese
        Berechtigung scheitert schon der erste `connect`, und zwar mit einem
        Fehlerbild, das wie „kein gemeinsames Netz" aussieht (ADR-001).
        Sie wird nicht zur Laufzeit erfragt.

        ADR-001 nennt zusätzlich `ACCESS_LOCAL_NETWORK` ab Android 17 für das
        Host-Gerät. Sie steht hier bewusst NOCH NICHT: Sie ist eine
        Laufzeitberechtigung mit eigenem Ablauf, und der ist `T-076`.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        T-075 — der Vordergrunddienst. ADR-001: „Ein Vordergrunddienst mit
        Benachrichtigung läuft, solange eine Partie aktiv ist."

        FOREGROUND_SERVICE_DATA_SYNC gehört zum Dienstart `dataSync`; ab
        Android 14 verlangt jeder Vordergrunddienst einen. Die Begründung für
        genau diesen Typ steht in `Sitzungsdienst`.

        POST_NOTIFICATIONS ist ab Android 13 nötig, damit die Benachrichtigung
        SICHTBAR ist — der Dienst läuft auch ohne sie. Der Ablauf, sie zu
        erfragen, gehört zu `T-076` und steht deshalb noch nirgends.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="Rise 1.0"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
            T-017: Der Katalog-Browser ist der Einstiegspunkt. Das ist die
            erste echte Oberfläche des Projekts; bis dahin startete die
            Statusseite aus T-005.

            Die Statusseite bleibt vollständig erhalten und ist über die
            Kopfzeile des Browsers erreichbar — sie zeigt weiterhin den
            Gerüststand und die versionName aus BuildConfig. Sie verliert nur
            ihren Platz im Startmenü. Mit T-140 wird sie durch die Tischansicht
            ersetzt; bis dahin ist der Tausch durch genau diesen Block
            umkehrbar.
        -->
        <!--
            Der Tisch ist der Einstieg. Bis hierher startete der
            Katalog-Browser (T-017); er bleibt vollstaendig erhalten und ist
            ueber die Kopfzeile des Tisches erreichbar — genau wie zuvor die
            Statusseite aus T-005. Ein Spiel beginnt am Tisch, nicht in der
            Kartenliste. Der Tausch ist durch diesen Block umkehrbar.
        -->
        <activity
            android:name=".sitzung.TischActivity"
            android:exported="true"
            android:label="Rise 1.0">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".browser.CatalogBrowserActivity"
            android:exported="false"
            android:label="Rise 1.0 — Katalog" />

        <!--
            ADR-004 — der lokale Prototyp-Modus. Befristet: Dieser Block
            verschwindet zusammen mit dem Verzeichnis
            `de.myhornets.rise1.prototyp` und der Tabelle
            `prototype_assignment`, sobald T-029/T-030 das echte Verfahren
            bringen.
        -->
        <activity
            android:name=".prototyp.PrototypActivity"
            android:exported="false"
            android:label="Rise 1.0 — Partie (Prototyp)" />

        <!--
            Nicht exportiert: Sie wird ausschließlich aus der App heraus mit
            einem ausdrücklichen Intent gestartet. Vorher musste sie exportiert
            sein, weil der Startmenü-Eintrag daran hing.
        -->
        <activity
            android:name=".StatusActivity"
            android:exported="false"
            android:label="Rise 1.0 — Status" />

        <!--
            T-075 — der Vordergrunddienst, der den Sitzungsthread hält.

            ADR-008: „Der Vordergrunddienst hält den Sitzungsthread am Leben,
            nicht die Oberfläche. Eine Activity, die verschwindet, darf keine
            Verbindung beenden."

            Nicht exportiert: Er wird ausschließlich aus der App heraus
            gestartet. Ein fremder Start wäre ein Dienst ohne Bausatz — er
            würde sich sofort wieder beenden, aber die Möglichkeit gehört gar
            nicht erst eröffnet.

            `dataSync`: Der Dienst hält den Abgleich des Event-Logs zwischen den
            Geräten am Laufen. Die Wahl und ihre bekannte Grenze — sechs Stunden
            je 24 ab Android 15 — sind in `Sitzungsdienst` begründet.
        -->
        <service
            android:name=".sitzung.Sitzungsdienst"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
